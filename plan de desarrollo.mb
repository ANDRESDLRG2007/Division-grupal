### C. Tarjeta Hero y Amigos en Salidas (`src/components/SalidasTab.tsx`)
```tsx
{/* 1. Tarjeta Hero Salida */}
<section className="card-unisplit p-5 flex flex-col gap-3 relative overflow-hidden">
  <div className="flex items-center justify-between">
    <span className="text-[11px] font-manrope font-bold uppercase tracking-wider text-[#F2F2F2]/60">
      Total de la Salida
    </span>
    <button 
      onClick={() => setMostrarCalculadora(true)}
      className="text-xs font-manrope font-semibold text-[#D2F25E] hover:underline flex items-center gap-1"
    >
      <Calculator size={13} /> Calculadora Mesa
    </button>
  </div>

  <h2 className="font-baloo text-4xl font-extrabold text-[#F2F2F2] tracking-tight">
    {fmt(totalSalidas)}
  </h2>

  {/* CTA Primario LIMA */}
  <button
    onClick={abrirModalNuevoGasto}
    className="btn-lima w-full py-3.5 px-4 text-base flex items-center justify-center gap-2 shadow-lg shadow-[#D2F25E]/15"
  >
    <Plus size={19} strokeWidth={3} />
    <span>Dividir Cuenta</span>
  </button>
</section>

{/* 2. Burbujas de Amigos (Stories) */}
<section className="flex flex-col gap-2">
  <div className="flex items-center justify-between px-1">
    <span className="text-xs font-manrope font-bold text-[#F2F2F2]/80 uppercase tracking-wider">
      El Parche ({contactos.length})
    </span>
    <button onClick={() => setMostrarModalAmigos(true)} className="text-xs font-manrope font-bold text-[#D2F25E]">
      Gestionar
    </button>
  </div>
  <div className="flex items-center gap-2.5 overflow-x-auto pb-1">
    {contactos.map(c => (
      <div key={c.id} className="flex flex-col items-center gap-1 shrink-0">
        <div className="w-12 h-12 rounded-2xl bg-[#18154C] border border-[#F2F2F2]/10 flex items-center justify-center text-xl">
          {c.avatar || '😎'}
        </div>
        <span className="text-[10px] font-manrope font-semibold text-[#F2F2F2]/90 max-w-[50px] truncate">
          {c.nombre}
        </span>
      </div>
    ))}
    <button onClick={() => setMostrarModalAmigos(true)} className="flex flex-col items-center gap-1 shrink-0">
      <div className="w-12 h-12 rounded-2xl border-2 border-dashed border-[#D2F25E]/40 text-[#D2F25E] flex items-center justify-center">
        <Plus size={18} strokeWidth={3} />
      </div>
      <span className="text-[10px] font-manrope font-bold text-[#D2F25E]">Añadir</span>
    </button>
  </div>
</section>

{/* 3. Micro Estado Vacío */}
{gastosSalida.length === 0 && (
  <div className="p-4 rounded-2xl border border-dashed border-[#F2F2F2]/10 bg-[#18154C]/50 flex items-center gap-3 text-left">
    <span className="text-2xl">🍕</span>
    <p className="text-xs font-manrope text-[#F2F2F2]/70 leading-snug">
      Aún no hay consumos registrados. Toca <strong className="text-[#D2F25E]">"Dividir Cuenta"</strong> para empezar.
    </p>
  </div>
)}
```

