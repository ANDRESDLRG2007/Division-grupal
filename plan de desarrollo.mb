### E. Botón de la Ruleta (`src/components/RuletaModal.tsx`)
```tsx
{/* Botón de girar ruleta con el Lima oficial de máximo contraste */}
<button
  onClick={girar}
  disabled={girando || count < 2}
  className="btn-lima w-full max-w-[280px] py-3.5 px-6 text-lg tracking-wide flex items-center justify-center gap-2 shadow-lg shadow-[#D2F25E]/20"
>
  <Dices size={22} strokeWidth={2.5} />
  <span>¡GIRAR RULETA!</span>
</button>
