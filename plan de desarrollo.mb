### B. Navbar con Identidad Oficial (`src/components/Navbar.tsx`)
```tsx
<header className="sticky top-0 z-40 px-4 pt-[max(env(safe-area-inset-top,0px),12px)] pb-3 bg-[#100E40]/95 backdrop-blur-md border-b border-[#F2F2F2]/10">
  <div className="max-w-[480px] mx-auto flex items-center justify-between">
    {/* Isotipo contextual: Uni en Blanco + Split en Lima */}
    <div className="flex items-center gap-2">
      <div className="w-8 h-8 rounded-xl bg-[#18154C] border border-[#F2F2F2]/10 flex items-center justify-center text-base">
        🍕
      </div>
      <h1 className="font-baloo text-xl font-extrabold tracking-tight">
        <span className="text-[#F2F2F2]">Uni</span>
        <span className="text-[#D2F25E]">Split</span>
      </h1>
      <span className="text-[10px] font-manrope font-bold px-2 py-0.5 rounded-full bg-[#D2F25E]/15 text-[#D2F25E] border border-[#D2F25E]/30">
        Parche
      </span>
    </div>

    {/* Acciones */}
    <div className="flex items-center gap-2">
      <button onClick={onOpenTicket} className="p-2 rounded-xl bg-[#18154C] border border-[#F2F2F2]/10 text-[#F2F2F2] hover:text-[#D2F25E]">
        <ReceiptText size={16} />
      </button>
      <button onClick={onOpenBackup} className="p-2 rounded-xl bg-[#18154C] border border-[#F2F2F2]/10 text-[#F2F2F2] hover:text-[#D2F25E]">
        <Settings2 size={16} />
      </button>
      <div className="py-1 px-2.5 rounded-xl bg-[#4EC26E]/15 border border-[#4EC26E]/30 text-[#4EC26E] font-manrope text-xs font-bold">
        {fmt(totalActual)}
      </div>
    </div>
  </div>
</header>
```

